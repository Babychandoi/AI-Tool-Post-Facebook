# Local pilot. Copy to .env. Never commit provider secrets.
DEMO_MODE=true
DEMO_PASSWORD=demo-marketing
LIVE_PUBLISHING=false
DATABASE_PASSWORD=marketing-local
S3_ACCESS_KEY=marketing
S3_SECRET_KEY=marketing-storage-local
# Set from: openssl rand -base64 32 ; retain across restarts and backups.
TOKEN_ENCRYPTION_KEY=
# Local personal installation. OAuth callback must use 127.0.0.1, not localhost.
CHATGPT_ENABLED=true
CHATGPT_REDIRECT_URI=http://127.0.0.1:5173/v1/ai/chatgpt/callback
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
# Experimental images from a dedicated ChatGPT browser profile, on the native local pilot.
CHATGPT_WEB_IMAGE_URL=http://127.0.0.1:58110
CHATGPT_WEB_IMAGE_TOKEN_FILE=.runtime/chatgpt-web-images/token
OPENAI_MODEL=
# USD micro-units (1 USD = 1,000,000). Configure prices from your provider contract.
GENERATION_RESERVE_MICROS=100000
OPENAI_INPUT_PRICE_MICROS_PER_MILLION=0
OPENAI_OUTPUT_PRICE_MICROS_PER_MILLION=0
META_GRAPH_VERSION=
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
SECURE_COOKIES=false
