{
  "manifest_version": 3,
  "name": "AI Marketing – Ảnh ChatGPT tự động",
  "version": "0.1.1",
  "description": "Nhận yêu cầu tạo ảnh từ AI Marketing local, tạo ảnh trong phiên ChatGPT của trình duyệt và trả ảnh về bài viết.",
  "key": "",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://*.oaiusercontent.com/*",
    "http://127.0.0.1:58110/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Kết nối ảnh ChatGPT"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
